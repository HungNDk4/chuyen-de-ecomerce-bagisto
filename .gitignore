# ==================================================
# NGOẠI LỆ BẮT BUỘC ĐỂ DỰ ÁN CLONE LÀ CHẠY NGAY
# ==================================================
# 1. Giữ file thực thi web
!/public/index.php
!/public/.htaccess
!/public/robots.txt
!/public/favicon.ico

# 2. Giữ toàn bộ bản build giao diện themes (Tránh lỗi ViteManifest)
!/public/themes/
!/public/themes/**

# 3. Giữ toàn bộ ảnh gốc trong storage
!/storage/app/public/
!/storage/app/public/**

# 4. Giữ thư mục chứa database mẫu và script tự động
!/mockdata/
!/mockdata/**
!setup.bat

# 5. KHÔNG commit symlink public/storage để tránh lỗi text rác trên Windows
public/storage